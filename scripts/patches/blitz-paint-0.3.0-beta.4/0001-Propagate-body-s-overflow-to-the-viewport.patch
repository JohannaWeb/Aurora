From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: JohannaWeb <joaocordeiroalmeida@gmail.com>
Date: Sat, 21 Nov 2026 00:00:00 +0000
Subject: [PATCH] Propagate body's overflow to the viewport
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

CSS Overflow 3 §3.3: when the root element's `overflow` is `visible`,
`<body>`'s `overflow` belongs to the viewport and body itself behaves as
`overflow: visible`. Upstream (since 0.3.0-beta.4) stops the root element
from clipping its own overflow, but still clips a `body { overflow-y:
scroll }` (YouTube) to body's box. When body's only in-flow-relevant
child is absolutely positioned that box is 0px tall, so every non-fixed
descendant was clipped away and the page painted blank below the fixed
masthead.

Drop when upstream has the equivalent fix.

diff --git a/src/render.rs b/src/render.rs
index 407fd1a..6ed02d3 100644
--- a/src/render.rs
+++ b/src/render.rs
@@ -349,13 +349,28 @@ impl<'dom, 'a> BlitzDomPainter<'dom, 'a> {
         // The root element's overflow is propagated to the viewport (which is clipped by the
         // window/surface bounds), so the root element must not clip its own overflow.
         let is_root_element = self.root_element_id == Some(node_id);
+        // Aurora patch, CSS Overflow 3.3: when the root element's `overflow` is
+        // `visible`, the `<body>`'s `overflow` is propagated to the viewport and
+        // body itself behaves as `overflow: visible`. Without this, a body with
+        // `overflow-y: scroll` (YouTube) clips all in-flow content to its own
+        // box, a 0px-tall box when its only child is absolutely positioned.
+        let overflow_propagated_to_viewport = node.local_name() == "body"
+            && node.parent.is_some_and(|parent_id| {
+                let parent = &self.dom.as_ref().tree()[parent_id];
+                parent.local_name() == "html"
+                    && parent.primary_styles().is_some_and(|root_styles| {
+                        matches!(root_styles.get_box().overflow_x, Overflow::Visible)
+                            && matches!(root_styles.get_box().overflow_y, Overflow::Visible)
+                    })
+            });
         let should_clip = !is_root_element
             && (is_image
                 || is_sub_doc
                 || is_text_input
                 || contain_paint
-                || !matches!(overflow_x, Overflow::Visible)
-                || !matches!(overflow_y, Overflow::Visible));
+                || (!overflow_propagated_to_viewport
+                    && (!matches!(overflow_x, Overflow::Visible)
+                        || !matches!(overflow_y, Overflow::Visible))));

         // Apply padding/border offset to inline root
         let taffy::Layout {
